# AI (both optional; Gemini is tried first, Groq is the automatic fallback)
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GROQ_MODEL=openai/gpt-oss-120b

# Database (Neon Postgres). Create the tables once with:  npm run db:setup
DATABASE_URL=

# Admin panel login (/admin). Use a long, unique password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: signs admin sessions. If unset it is derived from the username and password.
# ADMIN_SESSION_SECRET=

# Cloudflare R2 (image storage). All site images live under the "portfolio/" key prefix.
# Upload the bundled images once with:  npm run images:upload
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket URL (r2.dev or a custom domain) used to load images in the browser
S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
